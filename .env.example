# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio (ya está en .gitignore).
# Sin valores reales: las claves y contraseñas se generan o se piden al equipo.

# --- Entorno -----------------------------------------------------------------
# development | test | production. En production: COOKIE_SECURE=true, sslmode=require, JWT_SECRET no de ejemplo.
APP_ENV=development

# --- Servidor ----------------------------------------------------------------
# La dirección final es SERVER_HOST:SERVER_PORT. HTTP_ADDR (p. ej. :8080) tiene prioridad si se define.
SERVER_HOST=
SERVER_PORT=8080
# HTTP_ADDR=:8080

# --- Logs --------------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error. LOG_FORMAT: json | text (en production, json por defecto).
LOG_LEVEL=info
LOG_FORMAT=text
# Consultas más lentas que esto (ms, 10-60000) se registran como advertencia.
SLOW_QUERY_MS=200

# --- Base de datos -----------------------------------------------------------
# Rol de la aplicación: NO superusuario y NO dueño de las tablas, o RLS no se aplica.
DATABASE_URL=postgres://app_user:CAMBIAR@localhost:5432/prestamos?sslmode=disable
# Pool de conexiones. 0 = automático. DB_MIN_CONNS no puede superar DB_MAX_CONNS.
DB_MAX_CONNS=0
DB_MIN_CONNS=0
# Producción usa solo DATABASE_URL. Esta sobrescritura es opcional para desarrollo
# cuando las migraciones se ejecutan con un rol distinto que sea dueño de la base.
# MIGRATE_DATABASE_URL=postgres://owner:CAMBIAR@localhost:5432/prestamos?sslmode=disable
# Rol que recibe los permisos DML tras migrar (por defecto app_user).
APP_DB_USER=app_user
# Arranque automático de cmd/api (antes de abrir el pool y escuchar). Def. false.
# AUTO_MIGRATE=true aplica migraciones pendientes + permisos (permitido en production).
# AUTO_SEED=true asegura el superadmin (RECHAZADO en production: ahí usa go run ./cmd/seed).
AUTO_MIGRATE=false
AUTO_SEED=false

# --- Autenticación -----------------------------------------------------------
# Obligatoria, mínimo 32 bytes aleatorios. Genera con: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=prestamos
# Vida del access token (1m-24h) y del refresh token (1h-90d).
ACCESS_TTL=15m
REFRESH_TTL=720h
# Cookies (transporte web). En production debe ser true y el sitio ir por HTTPS.
COOKIE_SECURE=false
# Dominio de las cookies. Vacío = el del host actual.
COOKIE_DOMAIN=

# --- Seed del superadmin (go run ./cmd/seed o AUTO_SEED=true) ----------------
# Obligatorias para el seed: sin ellas el seed falla. No hay contraseña por defecto.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional (def. "Platform Admin").
SEED_ADMIN_NAME=
